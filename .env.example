# Used for canonical URLs and sitemap generation.
# Set this to your deployed site URL (no trailing slash).
VITE_SITE_URL=https://your-deployment-url.com

# Used by the Vercel serverless counter proxy (NOT exposed to browser).
# Workspace slug you created in CounterAPI.
COUNTERAPI_WORKSPACE=your-counterapi-workspace
# CounterAPI token. Keep secret; never commit the real value.
COUNTERAPI_TOKEN=your-counterapi-token
# Counter slug configured in code:
# - visits: total-visit

# ---------------------------------------------------------------------------
# Warehouse (primary blog source). When both are set, the writing/blog section
# is served from Warehouse: GET /api/blog reads from it, /blog + /blog/:slug are
# server-prerendered for crawlers (SEO + social cards), and /sitemap.xml is
# generated dynamically. SERVER-ONLY — never expose the key via a VITE_ var.
# ---------------------------------------------------------------------------
# Base URL of your Warehouse deployment (https:// in production).
WAREHOUSE_API_URL=https://your-warehouse-app.vercel.app
# Same value as API_ACCESS_KEY in Warehouse. Keep secret.
WAREHOUSE_API_KEY=your-warehouse-api-access-key

# ---------------------------------------------------------------------------
# Blog API (optional legacy/fallback). If Warehouse is NOT configured, the site
# falls back to KV/upstream (below) and finally to the posts bundled in
# src/data/blogs.json. Configure these only if you aren't using Warehouse.
# ---------------------------------------------------------------------------

# Where the client reads posts from. Defaults to "/api/blog" (the bundled
# serverless route). You can also point it at an external JSON feed.
VITE_BLOG_API_URL=/api/blog

# Secret bearer token your other website sends to publish posts (server-only).
# POST/DELETE to /api/blog require: Authorization: Bearer <BLOG_API_TOKEN>
BLOG_API_TOKEN=change-me-to-a-long-random-secret

# Storage for published posts (Upstash or Vercel KV — REST). Set ONE pair.
# Vercel KV:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash Redis (alternative):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: if you don't use KV, GET /api/blog can proxy an external JSON feed.
BLOG_UPSTREAM_URL=

# Optional: restrict who can call the blog API in the browser (CORS).
# Defaults to "*". Set to your other site's origin for tighter control.
BLOG_ALLOWED_ORIGIN=*
