# Used for canonical URLs and sitemap generation.
# Set this to your deployed site URL (no trailing slash).
VITE_SITE_URL=https://your-deployment-url.com

# Bing Webmaster Tools verification code used in <meta name="msvalidate.01" />.
VITE_BING_SITE_VERIFICATION=

# IndexNow settings.
# 1) Generate a key from Bing Webmaster Tools.
# 2) Set INDEXNOW_KEY to that value.
# 3) Enable auto notify in CI/CD only.
INDEXNOW_KEY=
INDEXNOW_AUTO_NOTIFY=false

# Used by Vercel serverless counter proxy (NOT exposed to browser).
# Workspace slug you created in CounterAPI.
COUNTERAPI_WORKSPACE=sujays-team-3055
# Regenerate and paste your CounterAPI token before deploy.
COUNTERAPI_TOKEN=your-regenerated-counterapi-token
# Counter slugs configured in code:
# - visits: total-visit
# - active: active-sessions
